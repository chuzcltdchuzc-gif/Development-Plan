# Copy to .env and fill in real values. Every one of these is required —
# the backend fails to start (fail-closed, see docs/ENGINEERING_RULES.md #2)
# rather than falling back to a default if any is missing. The placeholder
# values below are for local development only; never reuse them anywhere
# else.

# --- Shared ---
ENVIRONMENT=development

# --- Postgres (infra/docker/docker-compose.yml) ---
# POSTGRES_USER is the schema-OWNING role (created by the postgis image's
# own bootstrap) — used only for running migrations, never by the running
# app. See backend/migrations/versions/0002_app_role_least_privilege.py:
# a Postgres table owner bypasses GRANT/REVOKE and RLS regardless of what's
# revoked from it, so the app must connect as a different, non-owning role.
POSTGRES_USER=landvault
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=landvault
# Password for the `landvault_app` role that migration 0002 creates — the
# role the running application actually connects as.
POSTGRES_APP_PASSWORD=change-me-locally

# --- Backend (backend/app/kernel/config.py) ---
# When running outside Docker Compose, point both at localhost; inside
# Compose, the backend/migration services override these to use the
# `postgres` service hostname.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://landvault:change-me-locally@localhost:5432/landvault
DATABASE_URL=postgresql+asyncpg://landvault_app:change-me-locally@localhost:5432/landvault
# Comma-separated, no wildcard — see the CORS rule in docs/ENGINEERING_RULES.md #2.
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Supabase Auth (B1 — production identity provider, ADR-025) ---
# What the PEP actually verifies incoming access tokens against. The project
# URL derives both the JWKS endpoint and the issuer claim — see
# app/contexts/identity/adapters/supabase.py.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
# Supabase's fixed convention for authenticated users; override only if your
# project is genuinely configured differently.
SUPABASE_JWT_AUDIENCE=authenticated
# Supabase's current default for asymmetric (JWKS-published) project keys.
SUPABASE_JWT_ALGORITHM=ES256

# --- Supabase Storage (B5 IMVP-5 — real StoragePort adapter, ADR-025 E3 selects the adapter;
# docs/adr/ADR-027-supabase-storage-authorization-and-tenant-isolation.md governs its
# authorization/trust model — Accepted, pilot-only, three hard gates) ---
# Server-side only — the backend authenticates to Storage as itself, never
# forwarding a caller's own token. This bypasses Supabase Storage RLS entirely;
# FastAPI's PDP/PEP is the sole tenant-authorization boundary (ADR-027 §10.0).
# Accepts either current Supabase credential format (both carry the same
# elevated, RLS-bypassing role — https://supabase.com/docs/guides/api/api-keys):
# the current non-JWT "secret key" (sb_secret_...), preferred going forward, or
# the legacy service_role JWT, still valid until disabled in the dashboard.
# Never commit the real value; never log it; never return it from any API or
# generated client; never let it reach a Vite/frontend env var (those get
# inlined into the browser bundle — see artifacts/landvault-web/.env.example,
# which carries only the public anon key). Rotation/incident-response
# procedure: docs/EVIDENCE_STORAGE_CREDENTIAL_RUNBOOK.md.
SUPABASE_SERVICE_ROLE_KEY=change-me-locally
# The private bucket Evidence objects are written to (infra/supabase/evidence_bucket.sql).
SUPABASE_EVIDENCE_BUCKET=evidence

# --- Keycloak (infra/docker/docker-compose.yml) — HISTORICAL ---
# Retired as the production identity provider by ADR-025. Still required
# because /v1/auth/register|login|refresh still proxy to it (a separate,
# deferred disposition question — not touched by the Supabase integration).
# These are NOT used for verifying tokens on protected routes any more —
# that's SUPABASE_PROJECT_URL above.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally

# --- Keycloak client used by the backend (historical auth-proxy endpoints only) ---
# Realm base URL, e.g. http://localhost:8080/realms/landvault
KEYCLOAK_REALM_URL=http://localhost:8080/realms/landvault
# A confidential client with Direct Access Grants enabled (for password auth)
# and a service account with realm-management "manage-users" (for registration).
KEYCLOAK_CLIENT_ID=landvault-api
KEYCLOAK_CLIENT_SECRET=change-me-locally
KEYCLOAK_ADMIN_TOKEN_URL=http://localhost:8080/realms/landvault/protocol/openid-connect/token
KEYCLOAK_ADMIN_API_URL=http://localhost:8080/admin/realms/landvault
JWT_AUDIENCE=landvault-api
