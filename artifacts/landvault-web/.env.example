# Copy to .env.local (gitignored) and fill in real values.
#
# Only the Supabase PUBLIC anon key belongs here — Vite inlines every
# VITE_-prefixed variable directly into the browser bundle at build time.
# The service-role key must NEVER be set here, imported into this workspace,
# or referenced anywhere in src/ — it grants full database access and must
# stay server-side only (this frontend has no server side; it belongs to
# infrastructure that isn't this Vite app at all).

# Find both values in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The governed FastAPI backend's origin. Every generated API operation
# (@workspace/api-client-react) requests a relative path like /v1/parcels —
# without this, that relative path resolves against whatever origin served
# the page (this Vite app itself in dev, or wherever the static build is
# hosted in production), not the backend, and the app silently receives its
# own index.html instead of JSON. Not a proxy: this is a plain absolute
# origin, so it works identically in local dev and in a deployed build
# (e.g. Vercel) — just point it at whichever FastAPI deployment is current.
# Local dev default, when running the backend directly per its own README:
VITE_API_BASE_URL=http://127.0.0.1:8001
