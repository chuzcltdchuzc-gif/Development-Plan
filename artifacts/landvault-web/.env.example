# Copy to .env.local (gitignored) and fill in real values.
#
# Only the Supabase PUBLIC anon key belongs here — Vite inlines every
# VITE_-prefixed variable directly into the browser bundle at build time.
# The service-role key must NEVER be set here, imported into this workspace,
# or referenced anywhere in src/ — it grants full database access and must
# stay server-side only (this frontend has no server side; it belongs to
# infrastructure that isn't this Vite app at all).

# Find both values in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
